<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\PrestaFlow.Application\PrestaFlow.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <!--
      Fija la dependencia transitiva de Microsoft.Data.SqlClient 6.1.7, que trae Pkcs 9.0.11,
      vulnerable a GHSA-846f-f764-76mx (NU1903) y GHSA-2fmv-rv2c-59x7 (NU1902).
      Quitar cuando EF Core SqlServer dependa de un SqlClient que traiga Pkcs >= 9.0.21 o >= 10.0.13.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
